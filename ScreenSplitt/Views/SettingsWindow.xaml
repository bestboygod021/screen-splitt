<!-- FILE_ID: DLG-003 | FILE_PATH: ScreenSplitt/Views/SettingsWindow.xaml -->
<ui:UiWindow
    x:Class="ScreenSplitt.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="تنظیمات Screen Splitt"
    Width="450"
    Height="320"
    MinWidth="400"
    MinHeight="280"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize">

    <Border
        CornerRadius="8"
        BorderBrush="{DynamicResource SystemControlForegroundChromeHighBrush}"
        BorderThickness="1"
        Background="{DynamicResource SystemControlChromeMediumLowBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="تنظیمات"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0 0 16 0"
                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

            <StackPanel Grid.Row="1" Margin="0 8 0 0">
                <!-- شروع خودکار -->
                <ui:ToggleSwitch
                    x:Name="AutoStartToggle"
                    Content="شروع خودکار با ویندوز"
                    Margin="0 0 0 16"
                    Checked="AutoStartToggle_Checked"
                    Unchecked="AutoStartToggle_Unchecked" />

                <!-- تم تاریک -->
                <ui:ToggleSwitch
                    x:Name="DarkThemeToggle"
                    Content="استفاده از تم تاریک"
                    IsChecked="True"
                    Margin="0 0 0 16"
                    Checked="DarkThemeToggle_Checked"
                    Unchecked="DarkThemeToggle_Unchecked" />

                <TextBlock
                    Text="نسخه ۱.۰.۰"
                    FontSize="12"
                    Opacity="0.6"
                    Margin="0 16 0 0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0 16 0 0">
                <ui:Button
                    Content="بستن"
                    Appearance="Primary"
                    Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</ui:UiWindow>
